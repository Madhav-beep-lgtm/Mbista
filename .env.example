# Copy this file to .env and replace the values with your local or cPanel hosting details.
# On cPanel, DB_NAME and DB_USER usually include the cPanel account prefix, for example cpaneluser_dbname.

APP_ENV=production
APP_NAME="M.B Group"
APP_URL="https://www.mbca.com.np"

# The clock everything is dated by. PHP and MySQL are told the same thing, so a
# voucher saved at 11pm cannot land on the previous day because the database
# server happened to be on UTC. Defaults to Asia/Kathmandu if left unset.
APP_TIMEZONE=Asia/Kathmandu

DB_HOST=localhost
DB_NAME=cpaneluser_dbname
DB_USER=cpaneluser_dbuser
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Outgoing email (used by scheduled reports and future notifications).
# Leave MAIL_HOST empty to keep the safe default: emails are written to
# storage/mail/ instead of being sent. On cPanel, create an email account
# (cPanel -> Email Accounts) and use its SMTP settings here.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="M.B Group"
# Or, to use the host's built-in PHP mail() instead of SMTP:
# MAIL_TRANSPORT=mail

# ---------------------------------------------------------------------------
# Nightly database backup — deploy/backup-database.sh
# ---------------------------------------------------------------------------
# Where the dumps are written. Keep it OUTSIDE public_html: anything under the
# document root can be fetched over the web by anyone who guesses the name.
BACKUP_DIR=

# How many days of dumps to keep on this server. Older ones are deleted. A dump
# that failed verification is never deleted, so a bad night stays visible.
BACKUP_KEEP_DAYS=30

# Encrypt each dump with AES-256 before storing it. Strongly recommended: an
# unencrypted dump is every customer's name, PAN and balance in one readable
# file. Keep this passphrase SOMEWHERE ELSE — a backup you cannot decrypt is
# not a backup. Leave empty to store dumps unencrypted.
BACKUP_PASSPHRASE=

# Copy each dump off this server. A backup on the same disk as the database
# dies with that disk, and ransomware encrypts it alongside everything else.
#   BACKUP_REMOTE="rclone:gdrive:mbista-backups"
#   BACKUP_REMOTE="scp:backupuser@203.0.113.9:/srv/mbista"
BACKUP_REMOTE=
# Node API database back-pressure. Keep the connection limit within the
# database account's allowance; excess requests wait only up to this queue cap.
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100
